@startuml
skinparam backgroundColor #FFFFFF
actor Expert
actor Entreprise
participant "Frontend" as FE
participant "API Gateway" as GW
participant "MS4 Evaluation" as MS4
database "MySQL" as DB

Expert -> FE : note un projet
FE -> GW : POST /api/evaluations
GW -> MS4 : route /api/evaluations
MS4 -> MS4 : EvaluationController.handleCreate
MS4 -> MS4 : EvaluationService.create
MS4 -> MS4 : EvaluationRepository.save
MS4 -> DB : INSERT Evaluation
DB --> MS4 : row saved
MS4 --> GW : scores
GW --> FE : 201
FE --> EXP : note
@enduml
