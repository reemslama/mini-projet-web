@startuml
title MS2 · Participants — Cas d'utilisation (S4)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam FontName Helvetica
skinparam FontSize 12
skinparam UsecaseBackgroundColor #F7F9FC
skinparam UsecaseBorderColor #2E5A88
skinparam ActorBorderColor #2E5A88
skinparam PackageBorderColor #2E5A88

left to right direction
actor "Développeur" as DEV
actor "Entreprise" as ENT
actor "Admin" as ADM

package "MS2 · Participants" {
  usecase "Créer un profil développeur" as UC1
  usecase "Créer une équipe" as UC2
  usecase "S'inscrire à un défi (candidature)" as UC3
  usecase "Consulter les candidatures d'un défi" as UC4
}

DEV --> UC1
DEV --> UC2
DEV --> UC3
ENT --> UC4
ADM --> UC1
ADM --> UC3
@enduml
