@startuml
title Architecture globale — Arène (MT-41)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam FontName Helvetica
skinparam FontSize 11
skinparam ArrowFontSize 10
skinparam PackageBorderColor #2E5A88
skinparam ArrowColor #2E5A88
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #D9A400
skinparam nodesep 10
skinparam ranksep 18

' --- Acteurs (un seul point d'entrée applicatif) ---
actor "Entreprise · Développeur · Expert · Admin" as USERS

package "Client" {
  boundary "Frontend Angular 21" as FE
}

package "Infrastructure" {
  boundary "API Gateway :8080" as GW
  control "Eureka" as EU
  database "Keycloak (JWT)" as KC
}

package "Microservices" {
  component "MS1 · Challenges" as MS1
  component "MS2 · Participants" as MS2
  component "MS3 · Soumissions" as MS3
  component "MS4 · Évaluation" as MS4
  component "MS5 · Vérification" as MS5
  component "MS6 · Réputation" as MS6
}

package "Bases dédiées · serveurs distincts" {
  database "H2 · défis" as DB1
  database "H2 · participants" as DB2
  database "H2 · soumissions" as DB3
  database "MySQL · évaluation" as DB4
  database "PostgreSQL + pgvector" as DB5
  database "H2 · réputation" as DB6
}

package "Messagerie et exécution" {
  queue "RabbitMQ" as MQ
  component "Docker · sandbox" as DK
}

component "GitHub (externe)" as GH

' --- Flux client ---
USERS --> FE
FE --> GW : /{service}/api/**
GW ..> KC : JWT
GW ..> EU : découverte

' --- Routage REST ---
GW --> MS1 : /api/challenges
GW --> MS2 : /api/developers
GW --> MS3 : /api/submissions
GW --> MS4 : /api/evaluations
GW --> MS5 : /api/verifications
GW --> MS6 : /api/rankings

' --- Une base par service, sur un serveur distinct (ADR-001) ---
MS1 --> DB1
MS2 --> DB2
MS3 --> DB3
MS4 --> DB4
MS5 --> DB5
MS6 --> DB6

' --- Appels internes (OpenFeign) ---
MS5 --> MS1 : critères d'acceptation
MS5 --> MS3 : dépôt + verdict
MS4 --> MS3 : soumissions

' --- Exécution et référence externe ---
MS5 --> DK : tests isolés
MS5 ..> GH : clone au commit figé

' --- Événements RabbitMQ (détail § 6.2 du document technique) ---
MQ ..> MS1 : candidature, gagnants
MQ ..> MS2 : défi publié
MQ ..> MS3 : vérification, notation
MQ ..> MS4 : vérification, signalement
MQ ..> MS5 : défi publié, soumission
MQ ..> MS6 : candidature, résultat

note right of MQ
  Producteurs → consommateurs :
  challenge.published : MS1 → MS2, MS5
  submission.submitted : MS3 → MS5
  verification.completed : MS5 → MS3, MS4, MS6
  winners.declared : MS4 → MS1, MS6
  Catalogue complet : § 6.2 (document technique).
end note

legend bottom left
  ==== Légende
  <color:#2E5A88>———</color> appel synchrone REST / OpenFeign
  <color:#C07400>- - - -></color> événement asynchrone ou dépendance d'infrastructure
  Une base par service, sur un serveur distinct : aucune clé étrangère inter-services (ADR-001).
end legend
@enduml
