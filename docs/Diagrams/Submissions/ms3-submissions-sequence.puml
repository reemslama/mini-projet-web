@startuml
actor Developpeur
participant "Frontend" as FE
participant "API Gateway" as GW
participant "MS3 Soumissions" as MS3
participant "MS5 Verification" as MS5

Developpeur -> FE : soumet un depot
FE -> GW : POST /api/submissions
GW -> MS3 : route /api/submissions
MS3 --> GW : 201
GW --> FE : 201
MS3 -> MS5 : submission.submitted
MS5 --> MS3 : verification.completed
MS3 --> FE : verdict
@enduml
